{
  // Dictionary
  "cSpell.words": ["daypicker", "embla", "iandefined"],

  // Nested files
  "explorer.fileNesting.patterns": {
    "vercel.json": "edgeone.json",
    "bump.config.ts": "cliff.toml"
  },

  // Hidden files
  "files.exclude": {
    "**/node_modules": true,
    "**/*.tsbuildinfo": true,
    "**/.{fallow,tanstack}": true
  },

  // Readonly files
  "search.exclude": { "**/*.gen.*": true },
  "files.watcherExclude": { "**/*.gen.*": true },
  "files.readonlyInclude": { "**/*.gen.*": true },

  // Extension settings
  "js/ts.experimental.useTsgo": true,

  // Configure oxc toolchains
  "editor.formatOnSave": true,
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,

  // Enable oxc toolchains
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.sortImports": "never",
    "source.removeUnusedImports": "never",
    "source.fixAll.oxc": "explicit"
  }
}
