{
  "name": "@deftui/addons",
  "version": "0.2.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiriRainCat/deftui.git",
    "directory": "packages/addons"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./form": {
      "types": "./dist/form.d.mts",
      "import": "./dist/form.mjs"
    },
    "./modal": {
      "types": "./dist/modal.d.mts",
      "import": "./dist/modal.mjs"
    },
    "./router": {
      "types": "./dist/router.d.mts",
      "import": "./dist/router.mjs"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.css"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp lint",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "@deftui/react": "^0.2.4",
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.70.0",
    "react-hook-form": "^7.91.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@deftui/react": "^0.2.4",
    "@tanstack/react-router": "^1.170.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  }
}
